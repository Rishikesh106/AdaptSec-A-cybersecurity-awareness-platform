# AdaptSec Environment Configuration

# Database: SQLite for zero-config local development, or PostgreSQL in production:
# e.g., postgresql://postgres:password@localhost:5432/adaptsec
DATABASE_URL="file:./dev.db"

# Auth Secret (generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET="adaptsec-production-super-secret-key-change-in-prod-2026"
NEXTAUTH_URL="http://localhost:3000"

# Optional LLM Feature Flag (OpenAI, Gemini, or Claude). 
# AdaptSec runs fully with high-fidelity deterministic attack generators if unset.
LLM_ENABLED="false"
LLM_PROVIDER="mock"
LLM_API_KEY=""

# Email Provider (console, mock, or smtp)
EMAIL_PROVIDER="console"
