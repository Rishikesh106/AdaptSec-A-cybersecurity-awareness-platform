// AdaptSec Prisma Data Model
// Supports zero-config local development and managed PostgreSQL in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("ENTERPRISE_TRIAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  campaigns   Campaign[]
  auditLogs   AuditLog[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String?
  role           String    @default("LEARNER") // LEARNER, ORG_ADMIN, MANAGER, AUTHOR, SUPER_ADMIN
  department     String    @default("General")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  xp             Int       @default(0)
  level          Int       @default(1)
  streakDays     Int       @default(1)
  lastActiveAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attempts            Attempt[]
  skillMasteries      SkillMastery[]
  userBadges          UserBadge[]
  xpEvents            XPEvent[]
  campaignAssignments CampaignAssignment[]
  certificates        Certificate[]
}

model Track {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  description      String
  skillTag         String
  iconName         String       @default("Shield")
  estimatedMinutes Int          @default(30)
  orderIndex       Int          @default(0)
  createdAt        DateTime     @default(now())

  lessons          Lesson[]
  certificates     Certificate[]
}

model Lesson {
  id              String   @id @default(cuid())
  trackId         String
  track           Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title           String
  orderIndex      Int      @default(0)
  durationMinutes Int      @default(5)
  summary         String
  contentMarkdown String
  checkpointsJson String   // JSON string of checkpoints array
  createdAt       DateTime @default(now())
}

model Scenario {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  title                String
  channel              String    // INBOX, SMS, WHATSAPP, UPI, VOICE_CALL, FAKE_LOGIN
  difficulty           String    @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  skillTag             String    // phishing, credentials, payments, social_eng, browsing_wifi, data_privacy, incident_response
  description          String
  contentJson          String    // JSON string of ScenarioContent
  redFlagsJson         String    // JSON string of RedFlag[]
  correctAction        String    // REPORT_PHISH, IGNORE_SAFE, etc.
  explanationSuccess   String
  explanationFailure   String
  whatToDoInstead      String
  isPublished          Boolean   @default(true)
  orderIndex           Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  attempts             Attempt[]
}

model Question {
  id           String   @id @default(cuid())
  type         String   // MCQ, MULTI_SELECT, SCENARIO_BASED, DRAG_MATCH, SPOT_FLAG
  skillTag     String
  difficulty   String   @default("BEGINNER")
  prompt       String
  optionsJson  String   // JSON string of QuestionOption[]
  explanation  String
  imageUrl     String?
  matchPairsJson String? // JSON string of match pairs
  createdAt    DateTime @default(now())
}

model Attempt {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId   String
  scenario     Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  decision     String
  isCorrect    Boolean
  timeMs       Int
  flagsFoundJson  String // JSON string of string[]
  flagsMissedJson String // JSON string of string[]
  scoreEarned  Int       @default(0)
  createdAt    DateTime  @default(now())
}

model SkillMastery {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillTag      String
  score         Float     @default(50.0) // 0 to 100
  attemptsCount Int       @default(0)
  correctCount  Int       @default(0)
  nextReviewAt  DateTime?
  lastTestedAt  DateTime  @default(now())

  @@unique([userId, skillTag])
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String
  tier        String   @default("BRONZE")
  createdAt   DateTime @default(now())

  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

model Campaign {
  id             String    @id @default(cuid())
  orgId          String
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title          String
  description    String
  trackId        String?
  deadline       DateTime
  status         String    @default("ACTIVE") // ACTIVE, COMPLETED, DRAFT
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignments    CampaignAssignment[]
}

model CampaignAssignment {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED
  score        Float?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([campaignId, userId])
}

model Certificate {
  id              String   @id @default(cuid())
  certificateCode String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId         String
  track           Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  score           Float    @default(85.0)
  issuedAt        DateTime @default(now())
}

model ScamOfTheWeek {
  id                   String    @id @default(cuid())
  title                String
  category             String
  channel              String
  threatLevel          String    @default("HIGH") // MODERATE, HIGH, CRITICAL
  summary              String
  realWorldIncident    String
  keyIndicatorsJson    String    // JSON string of string[]
  preventiveAdvice     String
  simulationScenarioId String?
  publishedAt          DateTime  @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String?
  organization Organization? @relation(fields: [orgId], references: [id])
  actorId     String
  action      String
  targetType  String
  targetId    String?
  metadataJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}
